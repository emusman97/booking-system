{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "typeRoots": ["src/*"]
  },
  "lib": ["es2015"],
  "include": ["src/**/*", "*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
